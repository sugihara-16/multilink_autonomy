+// Project extension: synchronized, sequential visual updates on ONE inertial state.
+void LIVMapper::readCameraRig(ros::NodeHandle &nh) {
+  nh.getParam("multicamera/cameras",camera_names);
+  if(camera_names.empty())return; // unchanged upstream monocular configuration
+  if(!img_en || !lidar_en || hilti_en)throw std::runtime_error("Camera rig requires LIVO and hilti_en=false");
+  if(camera_names.size()>1 && exposure_estimate_en)
+    throw std::runtime_error("Camera rig requires vio/exposure_estimate_en=false (independent camera exposure states are not implemented)");
+  if(colmap_output_en)throw std::runtime_error("Camera rig COLMAP export is not supported");
+  std::set<std::string> names,topics;
+  for(const auto& name:camera_names){
+    if(name.empty() || name.find('/')!=std::string::npos || !names.insert(name).second)throw std::runtime_error("Invalid or duplicate camera name");
+    const auto ns="multicamera/"+name;std::string topic;std::vector<double> R,t;
+    if(!nh.getParam(ns+"/topic",topic) || topic.empty() || !topics.insert(topic).second ||
+       !nh.getParam(ns+"/Rcl",R) || !nh.getParam(ns+"/Pcl",t) || R.size()!=9 || t.size()!=3)
+      throw std::runtime_error("Missing camera calibration or duplicate image topic: "+name);
+    M3D rotation;rotation<<MAT_FROM_ARRAY(R);V3D translation;translation<<VEC_FROM_ARRAY(t);
+    if(!rotation.allFinite() || !translation.allFinite() || (rotation.transpose()*rotation-M3D::Identity()).norm()>1e-5 || std::abs(rotation.determinant()-1)>1e-5)
+      throw std::runtime_error("Invalid camera extrinsic: "+name);
+    camera_topics.push_back(topic);
+  }
+  int capacity;nh.param<int>("multicamera/max_pending_frames",capacity,100);
+  if(capacity<1 || capacity>1000)throw std::runtime_error("Invalid camera queue capacity");
+  camera_sync.reset(new SynchronizedImages<sensor_msgs::ImageConstPtr>(camera_names.size(),capacity));
+  camera_namespace="multicamera/"+camera_names.front()+"/camera";img_topic=camera_topics.front();
+  nh.getParam("multicamera/"+camera_names.front()+"/Rcl",cameraextrinR);
+  nh.getParam("multicamera/"+camera_names.front()+"/Pcl",cameraextrinT);
+}
+
+void LIVMapper::initializeCameraRig(ros::NodeHandle &nh) {
+  if(camera_names.empty())return;
+  camera_managers.push_back(vio_manager);
+  for(size_t i=1;i<camera_names.size();++i){
+    VIOManagerPtr v(new VIOManager());const auto ns="multicamera/"+camera_names[i];
+    if(!vk::camera_loader::loadFromRosNs(ns+"/camera",v->cam))throw std::runtime_error("Missing camera model: "+ns);
+    std::vector<double> R,t;nh.getParam(ns+"/Rcl",R);nh.getParam(ns+"/Pcl",t);
+    v->grid_size=grid_size;v->patch_size=patch_size;v->outlier_threshold=outlier_threshold;
+    v->setImuToLidarExtrinsic(extT,extR);v->setLidarToCameraExtrinsic(R,t);
+    v->state=&_state;v->state_propagat=&state_propagat;v->max_iterations=max_iterations;
+    v->img_point_cov=IMG_POINT_COV;v->normal_en=normal_en;v->inverse_composition_en=inverse_composition_en;
+    v->raycast_en=raycast_en;v->grid_n_width=0;v->grid_n_height=grid_n_height;
+    v->patch_pyrimid_level=patch_pyrimid_level;v->exposure_estimate_en=exposure_estimate_en;
+    v->colmap_output_en=false;v->plot_flag=false;v->initializeVIO();camera_managers.push_back(v);
+  }
+  camera_calls.assign(camera_names.size(),0);camera_constraints.assign(camera_names.size(),0);
+}
+
+void LIVMapper::camera_cbk(const sensor_msgs::ImageConstPtr &msg,size_t camera) {
+  if(!img_en)return;
+  std::unique_lock<std::mutex> lock(mtx_buffer);
+  auto bundle=camera_sync->push(camera,msg->header.stamp.toNSec(),msg);
+  if(camera_sync->dropped)ROS_WARN_THROTTLE(5,"Incomplete camera sets discarded: %lu",camera_sync->dropped);
+  if(!bundle)return;
+  const double time=bundle->images.front()->header.stamp.toSec()+img_time_offset;
+  if(last_timestamp_lidar<0 || time<=last_timestamp_img || time-last_timestamp_img<0.02)return;
+  if(camera_bundles.size()>=100){++camera_ready_dropped;ROS_WARN_THROTTLE(5,"Camera ready queue full; dropping new synchronized set");return;}
+  std::vector<cv::Mat> images;
+  for(size_t i=0;i<bundle->images.size();++i){
+    auto im=getImageFromMsg(bundle->images[i]);auto v=camera_managers[i];
+    if(im.empty() || std::lround(im.cols*v->image_resize_factor)!=v->width || std::lround(im.rows*v->image_resize_factor)!=v->height)
+      throw std::runtime_error("Image dimensions do not match calibrated camera: "+camera_names[i]);
+    images.push_back(im);
+  }
+  img_buffer.push_back(images.front());img_time_buffer.push_back(time);camera_bundles.push_back(std::move(images));
+  last_timestamp_img=time;lock.unlock();sig_buffer.notify_all();
+}
+
+void LIVMapper::processCameraRig() {
+  auto& m=LidarMeasures.measures.back();
+  if(m.images.size()!=camera_managers.size())throw std::runtime_error("Incomplete image set reached estimator");
+  // The next camera's prior is the preceding camera's POSTERIOR, including covariance.
+  // IMU and LiDAR are never replayed per camera. Each camera retains its own reference patches.
+  for(size_t i=0;i<camera_managers.size();++i){
+    auto v=camera_managers[i];state_propagat=_state;
+    const V3D before=_state.pos_end;const double trace=_state.cov.trace();
+    v->processFrame(m.images[i],_pv_list,voxelmap_manager->voxel_map_,LidarMeasures.last_lio_update_time-_first_lidar_time);
+    ++camera_calls[i];if(v->total_points>0)++camera_constraints[i];
+    std::cout<<"CAMERA_UPDATE "<<std::setprecision(17)<<m.vio_time<<" "<<camera_names[i]<<" "<<v->total_points<<" "<<(_state.pos_end-before).norm()<<" "<<trace<<" "<<_state.cov.trace()<<std::endl;
+  }
+  for(auto& v:camera_managers)v->updateFrameState(_state);
+  // Publish the final shared posterior at acquisition time, not wall time or the pre-visual pose.
+  nav_msgs::Odometry odom;odom.header.frame_id="camera_init";odom.child_frame_id="aft_mapped";
+  odom.header.stamp.fromSec(m.vio_time);
+  odom.pose.pose.position.x=_state.pos_end.x();odom.pose.pose.position.y=_state.pos_end.y();odom.pose.pose.position.z=_state.pos_end.z();
+  const Eigen::Quaterniond q(_state.rot_end);
+  odom.pose.pose.orientation.x=q.x();odom.pose.pose.orientation.y=q.y();odom.pose.pose.orientation.z=q.z();odom.pose.pose.orientation.w=q.w();
+  Eigen::Matrix<double,6,DIM_STATE> J=Eigen::Matrix<double,6,DIM_STATE>::Zero();
+  J.block<3,3>(0,3)=M3D::Identity();J.block<3,3>(3,0)=_state.rot_end;
+  const Eigen::Matrix<double,6,6> covariance=J*_state.cov*J.transpose();
+  for(int r=0;r<6;++r)for(int c=0;c<6;++c)odom.pose.covariance[r*6+c]=covariance(r,c);
+  const V3D velocity=_state.rot_end.transpose()*_state.vel_end;
+  odom.twist.twist.linear.x=velocity.x();odom.twist.twist.linear.y=velocity.y();odom.twist.twist.linear.z=velocity.z();
+  pubRigOdom.publish(odom);
+}
