+def world_velocity(keys, xy, z, quaternion):
+    """Rotate the summed baselink translation into the controller's world frame."""
+    v = (xy * (('w' in keys) - ('s' in keys)),
+         xy * (('a' in keys) - ('d' in keys)),
+         z * (('[' in keys) - (']' in keys)))
+    x, y, qz, w = quaternion
+    norm = math.sqrt(x*x + y*y + qz*qz + w*w)
+    if not math.isfinite(norm) or norm < 1e-6:
+        raise ValueError('Invalid baselink orientation')
+    x, y, qz, w = (a / norm for a in quaternion)
+    tx, ty, tz = (2*(y*v[2]-qz*v[1]), 2*(qz*v[0]-x*v[2]), 2*(x*v[1]-y*v[0]))
+    return (v[0] + w*tx + y*tz - qz*ty,
+            v[1] + w*ty + qz*tx - x*tz,
+            v[2] + w*tz + x*ty - y*tx)
 
 
