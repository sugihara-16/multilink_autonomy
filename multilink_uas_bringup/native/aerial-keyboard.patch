+"""Terminal input composition and baselink velocity regression tests."""
+import importlib.util
+import math
+from pathlib import Path
+import unittest
+
+spec = importlib.util.spec_from_file_location('keyboard_command', Path(__file__).parents[1]/'scripts/keyboard_command.py')
+keyboard = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(keyboard)
+
+
+class KeyboardTests(unittest.TestCase):
+    def test_recent_inputs_combine_and_expire_independently(self):
+        keys = keyboard.RecentKeys(.25)
+        keys.add('w', 1.0)
+        keys.add('a', 1.1)
+        keys.add('q', 1.15)
+        self.assertEqual(keys.active(1.2), {'w', 'a', 'q'})
+        self.assertEqual(keys.active(1.3), {'a', 'q'})
+        self.assertEqual(keys.active(1.5), set())
+
+    def test_repeat_refreshes_only_received_key_and_clear_stops_all(self):
+        keys = keyboard.RecentKeys(.25)
+        keys.add('w', 1.0)
+        keys.add('a', 1.1)
+        keys.add('a', 1.3)
+        self.assertEqual(keys.active(1.4), {'a'})
+        keys.clear()
+        self.assertFalse(keys.active(1.4))
+
+    def test_baselink_rotation_and_combined_velocity(self):
+        v = keyboard.world_velocity({'w', 'a'}, .4, .2, (0, 0, math.sqrt(.5), math.sqrt(.5)))
+        for value, expected in zip(v, [-.4, .4, 0]):
+            self.assertAlmostEqual(value, expected)
+        self.assertEqual(keyboard.world_velocity(set('wsad[]'), .4, .2, (0, 0, 0, 1)), (0, 0, 0))
+
+    def test_baselink_tilt_and_invalid_orientation(self):
+        v = keyboard.world_velocity({'w'}, .4, .2, (0, math.sqrt(.5), 0, math.sqrt(.5)))
+        self.assertAlmostEqual(v[0], 0)
+        self.assertAlmostEqual(v[2], -.4)
+        with self.assertRaises(ValueError):
+            keyboard.world_velocity({'w'}, .4, .2, (0, 0, 0, 0))
+
+
+if __name__ == '__main__':
+    unittest.main()
