+
+// Submit all due sensor rendering before the first synchronous readback.
+void RenderingSensor::PrepareRender()
+{
+  if (!this->dataPtr->manualSceneUpdate || this->dataPtr->prepared) return;
+  for (auto rs : this->dataPtr->sensors)
+  {
+    auto s=rs.lock();
+    auto camera=std::dynamic_pointer_cast<rendering::Camera>(s);
+    if (camera) camera->Render();
+  }
+  this->dataPtr->prepared=true;
+}
+extern "C" void uasPrepareSensorRender(gz::sensors::RenderingSensor *sensor)
+{
+  sensor->PrepareRender();
+}
