+bool Manager::waitForMeasurement(double ts, double timeout_seconds)
+{
+  std::unique_lock<std::mutex> lock(buffer_mutex_);
+  return buffer_updated_.wait_for(lock, std::chrono::duration<double>(timeout_seconds),
+    [&] { return !buffer_.empty() && buffer_.front().first <= ts && buffer_.back().first >= ts; });
+}
