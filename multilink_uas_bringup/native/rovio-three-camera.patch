+    for (int id = 0; id < mtState::nCam_; ++id) {
+      subImages_.push_back(nh_.subscribe<sensor_msgs::Image>(
+          "cam" + std::to_string(id) + "/image_raw", 10,
+          [this, id](const sensor_msgs::ImageConstPtr& img) {
+            std::lock_guard<std::mutex> lock(m_filter_);
+            const auto stamp = img->header.stamp.toNSec();
+            if (stamp <= lastImageStamp_) return;
+            auto& images = imageSets_[stamp];
+            images[id] = img;
+            bool complete = true;
+            for (const auto& image : images) complete = complete && bool(image);
+            if (complete) {
+              for (int i = 0; i < mtState::nCam_; ++i) imgCallback(images[i], i);
+              lastImageStamp_ = stamp;
+              imageSets_.erase(imageSets_.begin(), imageSets_.upper_bound(stamp));
+            }
+            while (imageSets_.size() > 10) imageSets_.erase(imageSets_.begin());
+          }));
+    }
     subGroundtruth_ = nh_.subscribe("pose", 1000, &RovioNode::groundtruthCallback,this);
     subGroundtruthOdometry_ = nh_.subscribe("odometry", 1000, &RovioNode::groundtruthOdometryCallback, this);
