 #include <ros/ros.h>
+#include <array>
+#include <map>
 #include <sensor_msgs/Image.h>
 #include <sensor_msgs/image_encodings.h>
 #include <sensor_msgs/Imu.h>
@@ -129,8 +131,9 @@ class RovioNode{
   ros::NodeHandle nh_;
   ros::NodeHandle nh_private_;
   ros::Subscriber subImu_;
-  ros::Subscriber subImg0_;
-  ros::Subscriber subImg1_;
+  std::vector<ros::Subscriber> subImages_;
+  std::map<uint64_t, std::array<sensor_msgs::ImageConstPtr, mtState::nCam_>> imageSets_;
+  uint64_t lastImageStamp_ = 0;
   ros::Subscriber subGroundtruth_;
   ros::Subscriber subGroundtruthOdometry_;
   ros::Subscriber subVelocity_;
@@ -206,8 +209,25 @@ class RovioNode{
 
     // Subscribe topics
     subImu_ = nh_.subscribe("imu0", 1000, &RovioNode::imuCallback,this);
-    subImg0_ = nh_.subscribe("cam0/image_raw", 1000, &RovioNode::imgCallback0,this);
