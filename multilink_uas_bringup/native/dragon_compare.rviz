Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /sensors1
    Splitter Ratio: 0.5
  Tree Height: 1081
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Expanded:
  - /2D Goal Pose1
  - /Publish Point1
  Name: Tool Properties
  Splitter Ratio: 0.5886790156364441
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
- Class: rviz_common/Time
  Experimental: false
  Name: Time
  SyncMode: 0
  SyncSource: lidar pc aggreg
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Path
    Name: TRUTH trajectory
    Enabled: true
    Topic:
      Value: /evaluation/truth/path
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Color: 60; 210; 70
    Line Style: Billboards
    Line Width: 0.035
  - Class: rviz_default_plugins/Odometry
    Name: TRUTH odometry
    Enabled: true
    Topic:
      Value: /evaluation/truth/odometry
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Keep: 1
    Shape: Axes
    Axes:
      Length: 0.4
      Radius: 0.035
    Covariance:
      Position:
        Value: false
      Orientation:
        Value: false
  - Class: rviz_default_plugins/Path
    Name: LIO trajectory
    Enabled: true
    Topic:
      Value: /evaluation/lio/path
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Color: 255; 150; 40
    Line Style: Billboards
    Line Width: 0.035
  - Class: rviz_default_plugins/Odometry
    Name: LIO odometry
    Enabled: true
    Topic:
      Value: /evaluation/lio/odometry
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Keep: 1
    Shape: Axes
    Axes:
      Length: 0.4
      Radius: 0.035
    Covariance:
      Position:
        Value: false
      Orientation:
        Value: false
  - Class: rviz_default_plugins/Path
    Name: VIO trajectory
    Enabled: true
    Topic:
      Value: /evaluation/vio/path
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Color: 50; 150; 255
    Line Style: Billboards
    Line Width: 0.035
  - Class: rviz_default_plugins/Odometry
    Name: VIO odometry
    Enabled: true
    Topic:
      Value: /evaluation/vio/odometry
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Keep: 1
    Shape: Axes
    Axes:
      Length: 0.4
      Radius: 0.035
    Covariance:
      Position:
        Value: false
      Orientation:
        Value: false
  - Class: rviz_default_plugins/Path
    Name: Planned route
    Enabled: true
    Topic:
      Value: /evaluation/planned_route
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Color: 180; 180; 180
    Line Style: Billboards
    Line Width: 0.04
  - Class: rviz_default_plugins/PointCloud2
    Name: LIO map
    Enabled: true
    Topic:
      Value: /slam/map
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Size (m): 0.04
    Style: Points
    Color Transformer: AxisColor
    Axis: Z
    Position Transformer: XYZ
    Decay Time: 0
  - Class: rviz_default_plugins/Image
    Name: Six-axis LIO VIO errors
    Enabled: true
    Topic:
      Value: /evaluation/error_plot
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Transport Hint: raw
    Normalize Range: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: evaluation_world
    Frame Rate: 20
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetInitialPose
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.06853891909122467
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /goal_pose
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.27539876103401184
      Target Frame: evaluation_robot
      Value: Orbit (rviz)
      Yaw: 3.215386152267456
    Saved: null
Window Geometry:
  Width: 1500
  Height: 900
  X: 0
  Y: 30
