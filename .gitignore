# ROS / CMake build output
build/
build_isolated/
install/
install_isolated/
devel/
devel_isolated/
log/
logs/
.catkin_tools/
CMakeFiles/
CMakeCache.txt
compile_commands.json

# Python and editor caches
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.swp
*.swo
*~

# Native supervisor runtime state and locally compiled checks
/multilink_uas_bringup/native/state.json
/multilink_uas_bringup/native/.supervisor.lock
/multilink_uas_bringup/native/check_normals

# Local migration records, backups and legacy reference snapshots
/multilink_uas_bringup/native/*.before-workspace-migration
/multilink_uas_bringup/native/workspace-migration*.json
/multilink_uas_bringup/native/relocation.json
/multilink_uas_bringup/native/handoff_reference/

# Windows download metadata
*:Zone.Identifier

# Recorded sensor data (even if saved outside logs/)
*.db3
*.db3-wal
*.db3-shm
*.bag
*.mcap
# Experiment ownership locks (no data or source content).
multilink_uas_bringup/native/.unipilot-*.lock

# Downloaded papers and PDF text extraction; retain source manifests and notes.
/for_codex/resources/**/*.pdf
/for_codex/resources/active_gimbal_20261008/*.txt

# Reproducible route previews, planning caches, and local capture state.
# Keep the selected route/segment definitions and their validation metadata.
/multilink_uas_bringup/native/routes/**/*.png
/multilink_uas_bringup/native/routes/**/*.gpickle
/multilink_uas_bringup/native/routes/**/*.log
/multilink_uas_bringup/native/routes/zab_full/capture_runs.json
.articulated.lock
